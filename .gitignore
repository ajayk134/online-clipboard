# ---------------------------------------------------------------
# Online Clipboard — .gitignore
# Secrets, credentials, databases, build artifacts and dependencies
# are intentionally excluded from version control.
# ---------------------------------------------------------------

# Environment files (contain JWT_SECRET, tokens, etc.)
.env
.env.local
.env.*.local
.env.example
*.env

# Secrets / credentials
*.key
*.pem
*.crt
*.cert
secrets/
credentials/

# Application data (SQLite database + WAL/SHM journals)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# TLS certificates
certs/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-deploy.yaml
.pnpm-store

# Build / output artifacts
dist/
build/
out/
.next/
.cache/
.parcel-cache/
*.tgz
bin/
obj/

# .NET build artifacts
*.user
*.userprefs
*.lock.json
publish/

# Test / coverage
coverage/
.nyc_output/
jest-styles/
tests/tmp/
/tmp/test-clipboard.db

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Misc
.tmp/
temp/

# Generated screenshot artifacts
/before/
/after/
/screenshots/
